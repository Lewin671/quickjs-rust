 pub(crate) use count;
+
+thread_local! { static INVENTORY: std::cell::RefCell<std::collections::BTreeMap<&'static str,u64>> = const { std::cell::RefCell::new(std::collections::BTreeMap::new()) }; }
+pub(crate) fn inventory_event(name: &'static str) { INVENTORY.with(|c| { *c.borrow_mut().entry(name).or_default() += 1; }); }
+fn inventory_entries() -> Vec<(&'static str,u64)> {
+    INVENTORY.with(|c| {
+        let mut c = c.borrow_mut();
+        for name in ["argument_vec_native_pop", "argument_vec_tier_fallback", "argument_vec_slice_fallback", "argument_vec_bound", "native_family_probes", "native_family_declines"] {
+            c.entry(name).or_default();
+        }
+        c.iter().map(|(k,v)| (*k,*v)).collect()
+    })
+}
+
+pub(crate) fn inventory_max(name: &'static str, value: u64) { INVENTORY.with(|c| { let mut c = c.borrow_mut(); let entry = c.entry(name).or_default(); *entry = (*entry).max(value); }); }
