+
+macro_rules! observe_ic {
+    ($kind:expr, $body:block) => {{
+        #[cfg(feature = "perf-counters")]
+        {
+            let result = (|| $body)();
+            $crate::diagnostics::mechanism::record_ic($kind, result.is_some());
+            result
+        }
+        #[cfg(not(feature = "perf-counters"))]
+        $body
+    }};
+}
+pub(crate) use observe_ic;
