+// The disabled expansions preserve the original equality expression.
+macro_rules! name_eq {
+    ($left:expr, $right:expr) => {{
+        #[cfg(feature = "perf-counters")]
+        {
+            $crate::diagnostics::mechanism::name_eq($left, $right)
+        }
+        #[cfg(not(feature = "perf-counters"))]
+        {
+            $left == $right
+        }
+    }};
+}
+pub(crate) use name_eq;
