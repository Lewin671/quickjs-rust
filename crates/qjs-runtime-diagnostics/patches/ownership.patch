+            Self::Null => Self::Null,
+            Self::Undefined => Self::Undefined,
+            Self::BigInt(value) => Self::BigInt(value.clone()),
+            Self::String(value) => Self::String(value.clone()),
+            Self::Function(value) => Self::Function(value.clone()),
+            Self::Array(value) => Self::Array(value.clone()),
+            Self::Object(value) => Self::Object(value.clone()),
+            Self::Proxy(value) => Self::Proxy(value.clone()),
+            Self::Map(value) => Self::Map(value.clone()),
