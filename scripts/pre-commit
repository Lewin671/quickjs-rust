#!/usr/bin/env bash
set -euo pipefail

# Git invokes hooks from the committing worktree, but exports repository-local
# variables. Nested test repositories must discover their own metadata instead
# of inheriting this index or Git directory. A shared hook symlink also need not
# point into this worktree, so resolve the checkout from the hook's cwd.
GIT_LOCAL_ENV_VARS="$(git rev-parse --local-env-vars)"
for variable in $GIT_LOCAL_ENV_VARS; do
  unset "$variable"
done
ROOT_DIR="$(git -C "$PWD" rev-parse --show-toplevel)"
. "$ROOT_DIR/scripts/lib.sh"

echo "pre-commit: change-aware fast checks..."
"$ROOT_DIR/scripts/check-touched.sh" --staged --explain
